{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dart: Açık dosyayı çalıştır",
      "type": "shell",
      "command": "dart",
      "args": ["run", "--enable-asserts", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "showReuseMessage": false, "echo": false },
      "problemMatcher": []
    }
  ]
}
